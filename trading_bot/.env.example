# Copy to .env (which is git-ignored) and fill in. NEVER commit real keys.
# Paper and live keys are separate on purpose: paper mode can only ever read
# the PAPER keys, so a config mistake can't send orders with live credentials.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Leave these blank until Stage 6 (go-live) is approved.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
